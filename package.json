{
  "name": "ocrflow",
  "version": "1.2.0",
  "description": "Multi-engine OCR document batch processing tool",
  "main": "dist-electron/main.js",
  "author": "LIU HUAN",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder && node -e \"var p=require('path'),f=require('fs'),d='release',v=f.readdirSync(d);v.forEach(function(n){if(n.endsWith('.blockmap')||n==='latest.yml'||n==='builder-debug.yml')f.unlinkSync(p.join(d,n))})\"",
    "parse": "electron . --headless parse",
    "mcp": "tsc && node dist-electron/mcp-server.js",
    "mcp:server": "node dist-electron/mcp-server.js",
    "vite:dev": "vite",
    "electron:dev": "electron ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.7.0",
    "form-data": "^4.0.5",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.33.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.0.0",
    "postcss": "^8.4.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-electron": "^0.28.0"
  },
  "build": {
    "appId": "com.ocrflow.app",
    "productName": "OCRFlow",
    "publish": null,
    "afterPack": "./scripts/afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "python/**",
      "ocr.ico",
      "ocr.png",
      "package.json"
    ],
    "asarUnpack": [
      "python/**",
      "dist-electron/mcp-server.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "ocr.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OCRFlow"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "ocr.png",
      "category": "public.app-category.productivity"
    }
  }
}
